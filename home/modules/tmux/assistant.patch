--- a/scripts/restore-assistant-sessions.sh
+++ b/scripts/restore-assistant-sessions.sh
@@ -51,6 +51,8 @@
 # not treat a zero-sleep return as proof nothing changed in the pane.
 wait_for_session_client() {
 	local pane_id="$1" client_wait=0
+	# The boot coordinator waits for a client once for the whole restore.
+	[ "${TMUX_ASSISTANT_FAST_RESTORE:-0}" != 1 ] || return 0
 	while [ "$(tmux list-clients -t "$pane_id" 2>/dev/null | wc -l)" -eq 0 ] && [ $client_wait -lt 50 ]; do
 		sleep 0.1
 		client_wait=$((client_wait + 1))
@@ -121,7 +123,7 @@
 _valid_delay "$LAUNCH_STAGGER" || LAUNCH_STAGGER=1
 
 # Wait for panes to be fully initialized after resurrect restore
-sleep 2
+[ "${TMUX_ASSISTANT_FAST_RESTORE:-0}" = 1 ] || sleep 2
 
 log "restoring $count assistant pane(s)..."
 
